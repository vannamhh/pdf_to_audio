# === API Keys ===
# Copy file này thành .env rồi điền key vào.
# File .env đã được .gitignore bảo vệ — không bị push lên GitHub.

# Google Cloud TTS — đường dẫn tới file Service Account JSON
# GOOGLE_CREDENTIALS_PATH=/path/to/your/credentials.json

# OpenAI TTS — API key từ platform.openai.com
# OPENAI_API_KEY=sk-...

# Google Gemini (AI Proofreading) — API key từ aistudio.google.com
# GEMINI_API_KEY=AIza...
